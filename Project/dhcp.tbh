'***********************************************************************************************************
'			DHCP LIBRARY
'			(Works with NET, WLN)
'***********************************************************************************************************

'1- debug output in console.
'0- no debug output.
#ifndef DHCP_DEBUG_PRINT
	#define DHCP_DEBUG_PRINT 0
#endif

'The number of retries in a single batch of retries
#ifndef DHCP_MAX_RETRIES
	#define DHCP_MAX_RETRIES 3
#endif

'Maximum waiting time (in seconds) for the DHCP server to reply
#ifndef DHCP_WAIT_TIME
	#define DHCP_WAIT_TIME 2
#endif

'Max delay (in seconds) between retries in a batch of retries (it is randomized between 1 and this constant for each retry)
#ifndef DHCP_MAX_RETRY_DELAY
	#define DHCP_MAX_RETRY_DELAY 10
#endif

'Delay (in seconds) between the batches of retries
#ifndef DHCP_POST_FAIL_DELAY
	#define DHCP_POST_FAIL_DELAY 180
#endif

'Max device (host) name length.
'
'The host name feature is DISABLED by default. At 0 the storage, the option 12
'emission in both the DISCOVER and the REQUEST, and the runtime test are all
'conditionally compiled out, so it costs nothing at all. The host_name argument
'of dhcp_start() remains in the API and is simply ignored, so callers that pass
'one need no change.
'
'Set this to the longest name you need -- 32 is a sensible maximum -- if you want
'the device to advertise its name to the DHCP server. Some servers are linked to
'a DNS server and will register the device under that name.
'
'RAM cost when enabled is (DHCP_MAX_HOST_NAME_LEN + 1) * DHCP_MAX_INTERFACES
'bytes. The name has to be retained per interface because the shared socket is
'released between the OFFER and the REQUEST, so another interface may run a
'transaction in between. At 32 with 4 interface slots that is 132 bytes;
'lowering DHCP_MAX_INTERFACES saves a further 33 per slot dropped.
'
'The total option block must stay under 255 bytes, so keep this below about 200.
#ifndef DHCP_MAX_HOST_NAME_LEN
	#define DHCP_MAX_HOST_NAME_LEN 0
#endif

'------------------------------------------------------------------------------
'TIMEBASE
'------------------------------------------------------------------------------
'All delays above are expressed in SECONDS. The library converts them into
'on_sys_timer ticks using the constant below, so this MUST match the actual
'rate at which your application calls dhcp_proc_timer() from on_sys_timer().
'
'The default of 2 assumes the standard 0.5 s system timer period. If you change
'sys.onsystimerperiod, change this to match, or every DHCP timeout, retry delay
'and lease renewal interval will be scaled by the same factor.
'
'This library deliberately does NOT use sys.timercountms, so it runs unchanged
'on T1000-based (gen-1) devices which do not provide that property.
#ifndef DHCP_TICKS_PER_SEC
	#define DHCP_TICKS_PER_SEC 2
#endif

'How many ticks the library will keep re-checking a socket that is still opening
'or closing before giving up on the attempt. The library never blocks waiting for
'a socket transition; it defers to the next tick instead, and this bounds how many
'times it will do so. At the default tick rate this is about 3 seconds.
#ifndef DHCP_SOCK_SETTLE_TICKS
	#define DHCP_SOCK_SETTLE_TICKS 6
#endif

'------------------------------------------------------------------------------
'INTERFACE TABLE SIZE
'------------------------------------------------------------------------------
'Per-interface state is indexed DIRECTLY by the pl_sock_interfaces value, so
'this must be greater than the highest interface number the library will be
'asked to serve (PL_SOCK_INTERFACE_NULL=0 occupies slot 0 and stays unused).
'The spare slots cost a few bytes each and buy a great deal of simplicity.
#ifndef DHCP_MAX_INTERFACES
	#define DHCP_MAX_INTERFACES 4
#endif

'------------------------------------------------------------------------------
'LEASE HANDLING
'------------------------------------------------------------------------------
'Lease time (in seconds) assumed when the server's ACK carries no option 51.
'Option 51 is mandatory in an ACK, so this should never be needed -- but a
'conservative value is far safer than assuming an effectively infinite lease.
#ifndef DHCP_DEFAULT_LEASE
	#define DHCP_DEFAULT_LEASE 86400
#endif

'Floor and ceiling (in seconds) applied to the computed renewal delay.
'The floor exists because a renewal delay of 0 ticks would disable the timer
'altogether. The ceiling keeps the tick arithmetic inside a dword.
#ifndef DHCP_MIN_RENEW_SEC
	#define DHCP_MIN_RENEW_SEC 10
#endif
#ifndef DHCP_MAX_RENEW_SEC
	#define DHCP_MAX_RENEW_SEC 2592000
#endif

'------------------------------------------------------------------------------
enum en_dhcp_status_codes
	DHCP_STATUS_OK,							'Success.
	DHCP_STATUS_OUT_OF_SOCKETS,				'No free sockets available for the library to operate.
	DHCP_STATUS_INVALID_INTERFACE,			'Unsupported network interface specified (use PL_SOCK_INTERFACE_NET or PL_SOCK_INTERFACE_WLN only).
	DHCP_STATUS_INSUFFICIENT_BUFFER_SPACE,	'Insufficient number of buffer pages available and the call to callback_dhcp_pre_buffrq() failed to cure the problem.
	DHCP_STATUS_FAILURE,					'Interaction with the DHCP server failed (because there was no reply, the reply was unrecognized, invalid, etc.).
	DHCP_STATUS_ALREADY_STARTED				'dhcp_start() was called for an interface on which the client is already running; the arguments were ignored. Appended last so existing code comparing against the earlier values is unaffected.
end enum

enum dhcp_info_elements
	DHCP_INFO_ELEMENT_REQUIRED_BUFFERS
end enum

'------------------------------------------------------------------------------
'LEASE HANDLING BEHAVIOUR
'------------------------------------------------------------------------------
'The library follows the RFC 2131 4.4.5 lease progression:
'
'  BOUND      An address is held. At T1 the client moves to RENEWING.
'             T1 comes from option 58 if the server supplies it, otherwise it
'             defaults to half the lease.
'
'  RENEWING   The REQUEST is UNICAST to the server that granted the lease, with
'             ciaddr set and no option 50 or 54. At T2 the client moves on.
'             T2 comes from option 59 if supplied, otherwise 7/8 of the lease.
'
'  REBINDING  The same REQUEST, but BROADCAST, so any server on the subnet may
'             answer. This is what recovers a lease when the original server has
'             gone away.
'
'  EXPIRED    When the lease runs out the client STOPS USING THE ADDRESS. The
'             library clears its record of it, calls callback_dhcp_pre_clear_ip()
'             and returns to DISCOVER. Your application must be prepared for the
'             interface IP to be zeroed at this point.
'
'A DHCPNAK at any stage abandons the address immediately and restarts from
'DISCOVER.
'
'If your application needs to keep using an address after its lease has run out,
'implement that in callback_dhcp_failure() rather than relying on the library --
'the library follows the RFC and surrenders it.

'------------------------------------------------------------------------------
'CALLBACK CONTRACT
'------------------------------------------------------------------------------
'The five callback procedures below are invoked from inside the library's own
'state machine. Two rules apply to the code you put in them:
'
' 1. Do NOT call dhcp_proc_timer() or dhcp_proc_data() from a callback. Both are
'    guarded and will simply return, but relying on that is asking for trouble.
'
' 2. dhcp_start() and dhcp_stop() ARE safe to call from a callback, including on
'    the interface whose callback is running. dhcp_stop() from inside
'    callback_dhcp_pre_clear_ip() or callback_dhcp_pre_buffrq() aborts the
'    exchange cleanly rather than being silently undone.
'
'Keep callbacks short regardless. They run inside on_sys_timer() or
'on_sock_data_arrival(), so anything slow in them delays the whole event queue --
'and in particular delays the processing of the very DHCP reply being waited for.

'------------------------------------------------------------------------------
declare function dhcp_get_info(info_element as dhcp_info_elements, byref extra_data as string) as string
declare function dhcp_start(interface as pl_sock_interfaces, byref requested_ip as string, byref host_name as string) as en_dhcp_status_codes
declare function dhcp_stop(interface as pl_sock_interfaces) as en_dhcp_status_codes
declare sub dhcp_set_link_disconnect_behavior(interface as pl_sock_interfaces, behavior as no_yes)
declare sub dhcp_proc_timer()
declare sub dhcp_proc_data()

declare sub callback_dhcp_ok(renew as no_yes, interface as pl_sock_interfaces, byref ip as string, byref gateway_ip as string, byref netmask as string, lease_time as dword)
'Callback procedure, informs of the successul procurement of configuration parameters from the DHCP server.
'lease_time is the true lease duration from option 51, NOT the renewal interval.
'Procedure body has to be created elsewhere in the project (externally with respect to the library).

declare sub callback_dhcp_failure(interface as pl_sock_interfaces,failure_code as en_dhcp_status_codes)
'Callback procedure, informs of the failure to procure configuration parameters from the DHCP server after DHCP_MAX_RETRIES.
'Procedure body has to be created elsewhere in the project (externally with respect to the library).

declare sub callback_dhcp_pre_clear_ip(interface as pl_sock_interfaces)
'Callback procedure, informs of the fact that the IP address of the specified interface will be cleared to 0.0.0.0 and all socket connections
'currently operating on this interface will be discarded.
'Procedure body has to be created elsewhere in the project (externally with respect to the library).

declare sub callback_dhcp_pre_buffrq(required_buff_pages as byte)
'Callback procedure, informs of the insufficient number of free buffer pages available for use by the library.
'The library cannot recover on its own -- if this callback does not free the requested number of pages,
'dhcp_sock_open() fails with DHCP_STATUS_INSUFFICIENT_BUFFER_SPACE.
'Procedure body has to be created elsewhere in the project (externally with respect to the library).

declare sub callback_dhcp_buff_released()
'Callback procedure, informs of the release of buffer pages by the library.
'Procedure body has to be created elsewhere in the project (externally with respect to the library).
